{
  "name": "eontyre-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typegen": "sanity schema extract --path src/sanity/schema.json --enforce-required-fields --force && sanity typegen generate",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "type-check": "tsc --noEmit",
    "deploy": "sanity deploy",
    "studio:build": "sanity build"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^2.0.28",
    "@sanity/vision": "^6.19.0",
    "next": "16.4.2",
    "next-sanity": "^13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^6.19.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
