# Copy to .env.local and fill in.
NEXT_PUBLIC_SANITY_PROJECT_ID=vitk5ups
NEXT_PUBLIC_SANITY_DATASET=production

# Viewer token (Sanity → API → Tokens). Needed for draft preview, and for the language
# switcher to find a page's translation when its address differs between languages.
SANITY_API_READ_TOKEN=

# One domain per language. Leave empty to serve every language under a path prefix
# (/sv, /en, /nb, /fi), which is what local development and previews use.
# Production: sv=eontyre.se,en=eontyre.com,nb=eontyre.no,fi=eontyre.fi
NEXT_PUBLIC_LOCALE_DOMAINS=

# Where contact, trial and newsletter submissions are sent (JSON POST).
FORMS_WEBHOOK_URL=

# Secret for the Sanity webhook that clears the cache on publish (POST /api/revalidate with
# the header "Authorization: Bearer <secret>"). Any long random string.
SANITY_REVALIDATE_SECRET=
